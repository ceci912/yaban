{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yaban-family-growth",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["dist/server/**/*.js", "dist/server/**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yaban-family-growth-db",
      "database_id": "57b48d14-ff46-4ed0-953e-ee510b78e9e7",
      "migrations_dir": "./drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
